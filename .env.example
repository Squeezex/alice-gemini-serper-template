# Required: Google AI Studio Gemini API key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: internet search via Serper; if omitted, Gemini still answers without search
# https://serper.dev
SERPER_API_KEY=

# New API keys: use 3.5 Flash-Lite. 2.5 often unavailable for new projects.
# Thinking is set to minimal in code to fit Alice's 4.5s limit.
GEMINI_MODEL=gemini-3.5-flash-lite

# AI provider: gemini (recommended), auto, or grok
AI_PROVIDER=gemini

# Optional alternative provider: xAI Grok
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Local server (Amvera sets PORT=80 automatically)
# PORT=3000
# HOST=0.0.0.0
