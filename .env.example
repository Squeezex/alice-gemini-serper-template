# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Required for internet search; if omitted, regular Gemini answers still work
SERPER_API_KEY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# AI provider: auto (default), gemini, or grok
AI_PROVIDER=auto

# Optional alternative provider: xAI Grok
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-3-mini
