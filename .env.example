# Required: Google AI Studio Gemini API key
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: internet search via Serper; if omitted, Gemini still answers without search
# https://serper.dev
SERPER_API_KEY=

# Fast model for Alice's 4.5s limit. Avoid gemini-3.x on Amvera — thinking is often too slow.
GEMINI_MODEL=gemini-2.5-flash-lite

# AI provider: gemini (recommended), auto, or grok
AI_PROVIDER=gemini

# Optional alternative provider: xAI Grok
GROK_API_KEY=
XAI_API_KEY=
GROK_MODEL=grok-4.7

# Local server (Amvera sets PORT=80 automatically)
# PORT=3000
# HOST=0.0.0.0
